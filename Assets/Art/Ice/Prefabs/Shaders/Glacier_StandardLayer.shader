#include "Assets/Art/ObscuredByClouds/Lighting/OBCPBRLighting.hlsl"
SamplerState sampler_Glacier_trilinear_repeat;
#define GLACIER_SAMPLE(tex,uv) tex.Sample(sampler_Glacier_trilinear_repeat,uv)
half4 GlacierBlinn(InputData i,SurfaceData s,half strength){i.bakedGI*=strength;return UniversalFragmentBlinnPhong(i,s);}
void GlacierSnow(inout InputData i,inout SurfaceData s,float enabled,float4 uv,float4 origin,float4 scale,float4 offset,half4 tint,float normalPower,Texture2D albedo,Texture2D normal,Texture2D mask)
{
    if(enabled<.5)return;
    float3 p=i.positionWS-origin.xyz+float3(uv.z,0,uv.w);
    float2 t=p.xz*uv.xy;
    half brightness=dot(s.albedo,half3(.2126,.7152,.0722));
    half chroma=max(s.albedo.r,max(s.albedo.g,s.albedo.b))-min(s.albedo.r,min(s.albedo.g,s.albedo.b));
    half coverage=smoothstep(.18,.55,brightness)*(1-smoothstep(.12,.4,chroma));
    half3 a=albedo.Sample(sampler_Glacier_trilinear_repeat,t).rgb*tint.rgb;
    half3 n=UnpackNormalScale(normal.Sample(sampler_Glacier_trilinear_repeat,t),normalPower);
    half4 m=mask.Sample(sampler_Glacier_trilinear_repeat,t)*scale+offset;
    s.albedo=lerp(s.albedo,a,coverage);
    i.normalWS=normalize(i.normalWS+half3(n.x,0,n.y)*coverage);
    s.metallic=lerp(s.metallic,m.r,coverage);s.occlusion=lerp(s.occlusion,m.g,coverage);s.smoothness=lerp(s.smoothness,m.a,coverage);
}

