				float4 tex2DNode16 = SAMPLE_TEXTURE2D( _BaseMap, sampler_BaseMap, uv_BaseMap );
				float4 temp_output_30_0 = ( tex2DNode16 * _BaseColorIntensity * _BaseColor );
				
